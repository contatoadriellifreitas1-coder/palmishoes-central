# ============================================================================
# 🔒 CONFIGURAÇÕES DE AMBIENTE - Palmishoes MVP
# ============================================================================
# 
# INSTRUÇÕES:
# 1. Copiar este arquivo: cp .env.example .env
# 2. Preencher as variáveis com seus valores
# 3. NUNCA fazer commit do arquivo .env (já adicionado ao .gitignore)
# 4. NUNCA compartilhar suas chaves/secrets com ninguém
# 5. Usar diferentes valores para cada ambiente (dev, staging, prod)
#
# ✅ Variáveis VITE_* são públicas (seguras para frontend)
# 🔒 Variáveis sem VITE_ são privadas (backend apenas)
# ============================================================================

# ============================================================================
# 🌐 APLICAÇÃO
# ============================================================================

# Ambiente de execução: development, production, staging
NODE_ENV=development

# URL base da aplicação
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# ============================================================================
# 🔐 SUPABASE - Autenticação e Banco de Dados
# ============================================================================

# URL do projeto Supabase (público)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública do Supabase (público)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGc...sua-chave-publica

# 🔒 SECRETO: Chave privada do Supabase (backend apenas)
# Nunca exponha no frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...sua-chave-privada

# ============================================================================
# 🍪 COOKIES - Configurações de Segurança
# ============================================================================

# Tempo de expiração do token de autenticação (segundos)
# Default: 3600 (1 hora)
VITE_AUTH_COOKIE_EXPIRY=3600

# Tempo de expiração do refresh token (segundos)
# Default: 604800 (7 dias)
VITE_REFRESH_TOKEN_EXPIRY=604800

# Cookie SameSite: Strict, Lax, None (CSRF protection)
VITE_COOKIE_SAME_SITE=Strict

# ============================================================================
# 📧 EMAIL - Configurações de Envio
# ============================================================================

# Provedor de email: resend, sendgrid, mailgun, aws-ses
VITE_EMAIL_PROVIDER=resend

# 🔒 Chave API do provedor de email
EMAIL_API_KEY=re_sua_chave_api

# Email remetente padrão
VITE_EMAIL_FROM=noreply@palmishoes.com.br

# ============================================================================
# 📊 ANALYTICS - Rastreamento e Monitoramento
# ============================================================================

# Google Analytics ID
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Sentry (Error Tracking) - Chave pública
VITE_SENTRY_DSN=https://seu_sentry_key@sentry.io/123456

# ============================================================================
# 🔐 SEGURANÇA
# ============================================================================

# 🔒 Chave para assinar JWTs
# Gerar com: openssl rand -base64 32
JWT_SECRET=sua_chave_secreta_jwt_bem_longa_e_complexa

# Rounds para bcrypt hash
BCRYPT_SALT_ROUNDS=10

# 🔒 Chave para encriptação de dados sensíveis
# Gerar com: openssl rand -hex 16
ENCRYPTION_KEY=sua_chave_encriptacao_32_caracteres

# CORS - Origens permitidas (separadas por vírgula)
VITE_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://palmishoes.com.br

# Rate Limiting - Requisições por minuto
VITE_RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ============================================================================
# 💾 BANCO DE DADOS
# ============================================================================

# URL de conexão (se usar fora do Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/palmishoes_db

# ============================================================================
# 🚀 DEPLOYMENT
# ============================================================================

# Server Configuration
NITRO_PRESET=cloudflare-module

# Vercel
VERCEL_URL=https://seu-projeto.vercel.app

# ============================================================================
# 📝 IMPORTANTE - Checklist de Segurança
# ============================================================================
#
# ✅ ANTES DE COMMITAR:
# - [ ] Verificar se .env está no .gitignore
# - [ ] Não colocar chaves privadas no código
# - [ ] Usar VITE_* apenas para variáveis públicas
# - [ ] Valores diferentes para cada ambiente (dev/staging/prod)
#
# ❌ NÃO FAZER:
# - Não colocar este arquivo em Git (use .gitignore)
# - Não compartilhar chaves/secrets com ninguém
# - Não usar a mesma chave em múltiplos ambientes
# - Não deixar chaves em comentários de código
# - Não expor chaves privadas (sem VITE_) no frontend
#
# 🔒 SEGURANÇA EM PRODUÇÃO:
# - Use variáveis de ambiente do hosting (Vercel, Netlify)
# - Rotacionar chaves periodicamente
# - Monitorar uso de chaves (rate limiting)
# - Usar secrets management tools (AWS Secrets Manager, etc)
# ============================================================================
